# SciPDF AI论文处理系统 v3 - 环境变量配置模板
# 复制此文件为 .env 并填写实际配置

# ===== 应用配置 =====
APP_NAME=SciPDF AI论文处理系统
APP_VERSION=3.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ===== PostgreSQL 数据库配置 =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE=article_analysis_v3

# ===== Milvus 向量数据库配置 - 云端 =====
MILVUS_URI=http://8.147.69.101:19530
MILVUS_HOST=8.147.69.101
MILVUS_PORT=19530

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== GROBID 配置 =====
GROBID_URL=http://localhost:8070

# ===== LLM 配置 =====
# OpenAI 或通义千问 API
API_KEY=your_api_key
BASE_URL=https://api.openai.com/v1
EMBEDDING_DIM=1024

# ===== JWT 认证配置 =====
SECRET_KEY=your_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=150
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Redis Token 缓存键前缀
REDIS_TOKEN_KEY_PREFIX=token:

# ===== 默认管理员配置（首次启动自动创建） =====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@example.com

# ===== PDF 处理配置 =====
PDF_MAX_RETRIES=3
PDF_RETRY_DELAY=2
MAX_UPLOAD_SIZE=100

# ===== 日志配置 =====
LOG_LEVEL=INFO