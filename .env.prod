# SciPDF AI论文处理系统 v3 - 生产环境配置模板
# 使用方法：复制为 .env 并填写实际密码
# cp .env.prod .env

# ===== 应用配置 =====
APP_NAME=SciPDF AI论文处理系统
APP_VERSION=3.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=WARNING
LOG_FILE=logs/app.log

# CORS 允许的前端域名（逗号分隔，* 表示全部允许）
# 绑定域名后建议改为：CORS_ORIGINS=https://yourdomain.com,http://yourdomain.com
CORS_ORIGINS=*

# ===== PostgreSQL 数据库配置 =====
# 已有基础设施，通过宿主机 IP 连接
POSTGRES_HOST=8.147.69.101
POSTGRES_PORT=5432
POSTGRES_USER=<填写数据库用户名>
POSTGRES_PASSWORD=<填写数据库密码>
POSTGRES_DATABASE=article_analysis_v3

# ===== Milvus 向量数据库配置 =====
MILVUS_URI=http://8.147.69.101:19530
MILVUS_HOST=8.147.69.101
MILVUS_PORT=19530
EMBEDDING_DIM=1024

# ===== Redis 配置 =====
REDIS_HOST=8.147.69.101
REDIS_PORT=6379
REDIS_PASSWORD=<填写Redis密码>
REDIS_DB=0
REDIS_URL=redis://:<填写Redis密码>@8.147.69.101:6379/0

# ===== GROBID 配置 =====
GROBID_URL=http://8.147.69.101:8070

# ===== LLM 配置 - 通义千问 =====
API_KEY=<填写通义千问API密钥>
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.6-plus

# ===== JWT 认证配置 =====
SECRET_KEY=<填写JWT密钥，建议32位随机字符串>
JWT_SECRET=<填写JWT签名密钥>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=150
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Redis Token 缓存键前缀
REDIS_TOKEN_KEY_PREFIX=token:

# ===== 默认管理员配置（首次启动自动创建） =====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=<填写管理员密码>
DEFAULT_ADMIN_EMAIL=admin@example.com

# ===== PDF 处理配置 =====
PDF_MAX_RETRIES=3
PDF_RETRY_DELAY=2
MAX_UPLOAD_SIZE=104857600

# ===== 文件存储配置 =====
UPLOAD_DIR=data/uploads
RESULT_DIR=data/results
NER_DIR=data/ner_results
RE_DIR=data/re_results
